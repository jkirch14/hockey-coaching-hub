datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum TeamRole {
  OWNER
  ADMIN
  VIEWER
}

enum GameResult {
  WIN
  LOSS
  TIE
}

enum GameStatus {
  SCHEDULED
  FINAL
  CANCELLED
}

enum ShootSide {
  LEFT
  RIGHT
}

enum Position {
  C
  LW
  RW
  LD
  RD
  G
  OTHER
}

enum EvaluationConfidence {
  LOW
  MEDIUM
  HIGH
}

enum ObservationSource {
  GAME
  PRACTICE
  GENERAL
}

enum ObservationCategory {
  SKATING
  SPEED
  PUCK_CONTROL
  PASSING
  SHOOTING
  HOCKEY_IQ
  COMPETE
  DEFENSE
  POSITIONING
  TEAM_PLAY
  LEADERSHIP
  GOALTENDING
  CHEMISTRY
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  memberships TeamMember[]
  ownedTeams  Team[]       @relation("TeamOwner")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner             User               @relation("TeamOwner", fields: [ownerId], references: [id])
  members           TeamMember[]
  players           Player[]
  games             Game[]
  lineupEntries     LineupEntry[]
  invites           TeamInvite[]
  seasons           Season[]
  coachObservations CoachObservation[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(VIEWER)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

model TeamInvite {
  id         String    @id @default(cuid())
  teamId     String
  email      String
  role       TeamRole  @default(VIEWER)
  token      String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId, email])
}

model Player {
  id          String     @id @default(cuid())
  teamId      String
  name        String
  number      Int?
  shootSide   ShootSide?
  parentsName String?
  createdAt   DateTime   @default(now())

  team              Team               @relation(fields: [teamId], references: [id])
  lineupEntries     LineupEntry[]
  playerOfGameIn    Game[]             @relation("PlayerOfGame")
  seasonMemberships SeasonPlayer[]
  evaluations       PlayerEvaluation[]
  coachObservations CoachObservation[]

  @@unique([teamId, number])
  @@index([teamId, name])
}

model Game {
  id             String     @id @default(cuid())
  teamId         String
  seasonId       String?
  date           DateTime
  location       String?
  opponent       String
  league         String?
  status         GameStatus @default(FINAL)
  result         GameResult?
  goalsFor       Int        @default(0)
  goalsAgainst   Int        @default(0)

  externalSource     String?
  externalGameId     String?
  externalTeamId     String?
  externalSeasonId   String?
  externalDivisionId String?
  jerseyColor    String?
  notes          String?
  playerOfGameId String?
  createdAt      DateTime   @default(now())

  team              Team               @relation(fields: [teamId], references: [id])
  season            Season?            @relation(fields: [seasonId], references: [id])
  playerOfGame      Player?            @relation("PlayerOfGame", fields: [playerOfGameId], references: [id])
  lineupEntries     LineupEntry[]
  coachObservations CoachObservation[]
  @@unique([teamId, externalSource, externalGameId])
  @@index([teamId, date])
  @@index([teamId, league])
  @@index([teamId, status])
  @@index([seasonId, date])
}

model LineupEntry {
  id       String @id @default(cuid())
  teamId   String
  gameId   String
  playerId String

  position  Position
  line      Int?
  goals     Int      @default(0)
  assists   Int      @default(0)
  penalties Int      @default(0)
  shutout   Boolean  @default(false)

  createdAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id])
  game   Game   @relation(fields: [gameId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([gameId, playerId])
  @@index([teamId, playerId])
  @@index([teamId, gameId])
}

model Season {
  id        String    @id @default(cuid())
  teamId    String
  name      String
  startDate DateTime
  endDate   DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  team              Team               @relation(fields: [teamId], references: [id])
  roster            SeasonPlayer[]
  games             Game[]
  playerEvaluations PlayerEvaluation[]
  coachObservations CoachObservation[]

  @@index([teamId, active])
}

model SeasonPlayer {
  id       String  @id @default(cuid())
  seasonId String
  playerId String
  active   Boolean @default(true)

  primaryPosition Position?

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([seasonId, playerId])
  @@index([playerId])
}

model PlayerEvaluation {
  id       String @id @default(cuid())
  seasonId String
  playerId String

  coachRank Int?

  primaryPosition    Position?
  secondaryPositions Position[]

  playerType String?
  confidence EvaluationConfidence @default(LOW)

  skating          Int?
  speed            Int?
  puckControl      Int?
  passing          Int?
  shooting         Int?
  hockeyIQ         Int?
  compete          Int?
  defensiveAbility Int?
  positioning      Int?
  teamPlay         Int?

  strengths             String?
  developmentPriorities String?
  coachNotes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([seasonId, playerId])
  @@index([playerId])
}

model CoachObservation {
  id       String  @id @default(cuid())
  teamId   String
  seasonId String?
  playerId String
  gameId   String?

  date     DateTime            @default(now())
  source   ObservationSource
  category ObservationCategory

  note String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  player Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  game   Game?   @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([teamId, date])
  @@index([playerId, date])
  @@index([gameId])
  @@index([seasonId])
}

